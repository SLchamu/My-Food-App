<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:fillViewport="true"
    tools:context=".NearbySellerActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnNearbyBack"
                style="@style/ModernButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Back"
                android:backgroundTint="#FF5722"
                android:textColor="#FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Nearby Seller"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary_orange" />
        </RelativeLayout>

        <!-- Connection Status Banner -->
        <androidx.cardview.widget.CardView
            style="@style/ModernCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@color/seller_green_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🟢 Devices Connected via QR Scan"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/seller_green" />

                <Button
                    android:id="@+id/btnRequestLocation"
                    style="@style/ModernButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share GPS"
                    android:textSize="12sp"
                    android:backgroundTint="@color/seller_green"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Scanned Seller Details Hero Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardNearbyDetails"
            style="@style/ModernCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏪 Connected Seller Details"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_orange"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvNearbySellerDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seller Info Details"
                    android:textSize="15sp"
                    android:textColor="@color/text_dark"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCallSeller"
                        style="@style/ModernButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="📞 Call Seller"
                        android:backgroundTint="@color/seller_green"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnOpenMapLocation"
                        style="@style/ModernButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="🗺️ Open Map"
                        android:backgroundTint="#2196F3"
                        android:textColor="#FFFFFF" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Order Summary Hero Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardNearbySummary"
            style="@style/ModernCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/primary_orange_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📦 Order Items Summary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_orange"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvNearbyOrderItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No items selected yet. You can order directly below or select items from menu!"
                    android:textSize="15sp"
                    android:textColor="@color/text_dark" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Order Button -->
        <Button
            android:id="@+id/btnOrderNearbySeller"
            style="@style/ModernButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛒 Send Order to Connected Seller"
            android:backgroundTint="@color/seller_green"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
