<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:fillViewport="true"
    tools:context=".FoodMenuActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Brown Menu Bar: ONLY Profile on Left & Settings on Right -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/primary_brown">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <!-- Left Side: My Profile Icon -->
                <LinearLayout
                    android:id="@+id/layoutLeftProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:id="@+id/btnBuyerProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_food_buyer"
                            android:contentDescription="My Profile Icon"
                            app:tint="#FFFFFF" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Profile"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginStart="2dp"/>

                </LinearLayout>

                <!-- Center: Menu Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="My Food Menu"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <!-- Right Side: ONLY Settings Icon -->
                <FrameLayout
                    android:id="@+id/btnBuyerSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_store"
                        android:contentDescription="Settings Icon"
                        app:tint="#FFFFFF" />
                </FrameLayout>

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <!-- Quick Action Bar UNDER the Menu Bar: QR Camera, Upload QR, Cart -->
        <androidx.cardview.widget.CardView
            style="@style/ModernCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/primary_orange_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="8dp">

                <!-- Scan QR Code via Camera -->
                <LinearLayout
                    android:id="@+id/btnScanSellerQr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_qr_code"
                        android:contentDescription="Scan QR Icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scan QR"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_orange"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:background="@color/card_border" />

                <!-- Upload QR Photo from Gallery -->
                <LinearLayout
                    android:id="@+id/btnUploadQrPhoto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_upload_qr"
                        android:contentDescription="Upload QR Icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload QR"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_orange"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:background="@color/card_border" />

                <!-- Shopping Cart Icon -->
                <LinearLayout
                    android:id="@+id/btnCart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_cart"
                            android:contentDescription="Cart Icon" />

                        <TextView
                            android:id="@+id/tvCartBadge"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/badge_background"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:text="0" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Cart"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_orange"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Category Banner Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛒 බඩු සහ ආහාර කාණ්ඩ (Categories)"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/primary_orange"
            android:gravity="center"
            android:paddingBottom="20dp" />

        <!-- 1. Soap Category Card (Teal Theme) -->
        <androidx.cardview.widget.CardView
            style="@style/ModernCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#E0F7FA">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_soap"
                    android:contentDescription="Soaps Icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="සබන් වර්ග (Soaps)"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#00838F" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kohomba, Sunlight, Velvet &amp; more"
                        android:textSize="12sp"
                        android:textColor="#006064" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnBurger"
                    style="@style/ModernButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="තෝරන්න"
                    android:backgroundTint="#00838F"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2. Provisions / Fresh Food Category Card (Orange Theme) -->
        <androidx.cardview.widget.CardView
            style="@style/ModernCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#FFF3E0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_food_buyer"
                    android:contentDescription="Provisions Icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="පිලිහුඩු / මස් මාළු (Provisions)"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#E65100" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fresh meat, fish &amp; daily groceries"
                        android:textSize="12sp"
                        android:textColor="#BF360C" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnPizza"
                    style="@style/ModernButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="තෝරන්න"
                    android:backgroundTint="#E65100"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. Spices Category Card (Amber Theme) -->
        <androidx.cardview.widget.CardView
            style="@style/ModernCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#FFFDE7">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_store"
                    android:contentDescription="Spices Icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="කුළුබඩු (Spices)"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#F57F17" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Authentic Sri Lankan spices &amp; herbs"
                        android:textSize="12sp"
                        android:textColor="#F57F17" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnChicken"
                    style="@style/ModernButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="තෝරන්න"
                    android:backgroundTint="#F57F17"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 4. Shampoo Category Card (Purple Theme) -->
        <androidx.cardview.widget.CardView
            style="@style/ModernCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#EDE7F6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_shampoo"
                    android:contentDescription="Shampoo Icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ෂැම්පු වර්ග (Shampoo Brands)"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#512DA8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sunsilk, Lifebuoy, Clear, Dove &amp; more"
                        android:textSize="12sp"
                        android:textColor="#311B92" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnShampoo"
                    style="@style/ModernButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="තෝරන්න"
                    android:backgroundTint="#512DA8"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 5. School Stationery Category Card (Green Theme) -->
        <androidx.cardview.widget.CardView
            style="@style/ModernCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#E8F5E9">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_stationery"
                    android:contentDescription="Stationery Icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="පාසල් උපකරණ (School Items)"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CR Books, Pens, Pencils, Bags &amp; more"
                        android:textSize="12sp"
                        android:textColor="#1B5E20" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnStationery"
                    style="@style/ModernButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="තෝරන්න"
                    android:backgroundTint="#2E7D32"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 6. Fast Food Category Card (Red Theme) -->
        <androidx.cardview.widget.CardView
            style="@style/ModernCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#FFEBEE">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_food_buyer"
                    android:contentDescription="Fast Food Icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ක්ෂණික ආහාර (Fast Food)"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#C62828" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Burgers, Pizzas, Fries &amp; Short eats"
                        android:textSize="12sp"
                        android:textColor="#B71C1C" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnFries"
                    style="@style/ModernButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="තෝරන්න"
                    android:backgroundTint="#C62828"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 7. Beverages Category Card (Indigo Theme) -->
        <androidx.cardview.widget.CardView
            style="@style/ModernCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#E8EAF6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_food_buyer"
                    android:contentDescription="Drinks Icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="බීම වර්ග (Beverages &amp; Drinks)"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#283593" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fresh juices, soft drinks &amp; tea"
                        android:textSize="12sp"
                        android:textColor="#1A237E" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnDrinks"
                    style="@style/ModernButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="තෝරන්න"
                    android:backgroundTint="#283593"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
